# Copy to .env and change what you need. Every value here has a default in
# src/pdf2sdmx/config.py, so an empty .env runs the same as none at all.
#
# Reading another office's reports is meant to be done from this file rather than from the
# code. The thresholds were measured on one publisher; another one will want its own.

# Who publishes. AGENCY goes into the SDMX ids, COUNTRY into REF_AREA where a table gives
# no breakdown, and COUNTRY_NAME is also read as a total row label, because a national
# table prints the country where another would print "Total".
AGENCY=INS_NE
COUNTRY=NE
COUNTRY_NAME=Niger

# The vocabulary: one row per printed label, with the SDMX code it stands for. An input,
# like the PDF. `make harvest` writes a worklist of what is still unnamed.
MAPPING_FILE=mapping/labels_to_codes.csv

# Where the reports are, and where the official code lists are kept once fetched.
DATA_RAW=data/raw
DATA_PROCESSED=data/processed
REFERENCE_DIR=data/reference
SOURCES_FILE=data/sources.csv

# --- What counts as a table -------------------------------------------------------------
# The text stage reads every page. A page where it finds no table, and that holds fewer
# digits than this, is not handed to the model stages, which take seconds a page. So this
# only trades time: it cannot lose a table the text layer can read. No count separates
# the two kinds of page anyway. On three reports, pages with a table held as few as 68
# digits, and pages without one as many as several hundred.
MIN_DIGITS_FOR_A_TABLE=100

# A page's number format is read from the page ("1 234,5" or "1,234.5"); this decides when
# it shows neither. fr or en.
NUMBER_FORMAT=fr
# Pages read per run, from the page shown. 0 reads the whole document.
MAX_PAGES=0

# What an extracted table must look like to be accepted. A register whose columns are
# mostly names rather than numbers needs a lower numeric share than a table of regions by
# indicator; at 0.5 those registers are refused.
GATE_MIN_ROWS=2
GATE_MIN_COLUMNS=2
GATE_MIN_NUMERIC_SHARE=0.5
GATE_MAX_UNREADABLE_SHARE=0.15

# Share of a row's cells that must read as periods for that row to be a header rather than
# data. Column names are often years, and a year reads as a number.
HEADER_PERIOD_SHARE=0.5

# --- Coding -----------------------------------------------------------------------------
# How close a printed label must be to a vocabulary entry to take its code, out of 100.
# Lower it and unrelated words start sharing a code, which is silent and hard to find.
VOCABULARY_MATCH_THRESHOLD=88

# --- Arithmetic checks ------------------------------------------------------------------
# A printed total is rounded independently of its parts, so an exact match is not the test.
# ABSOLUTE_TOLERANCE covers values printed to the unit: 1 against 1.4 is not an error.
# A change beyond JUMP_FACTOR between periods is reported, never corrected.
SUM_TOLERANCE=0.005
PRODUCT_TOLERANCE=0.02
ABSOLUTE_TOLERANCE=1.0
JUMP_FACTOR=5.0
UPPER_BOUND=1e9

# --- Serving ----------------------------------------------------------------------------
REQUEST_TIMEOUT=120
MAX_PDF_MB=50
API_URL=http://localhost:8000
LOG_LEVEL=INFO
